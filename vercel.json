{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "{server/models/**,model/**,scripts/**,node_modules/onnxruntime-node/**,node_modules/sharp/**,node_modules/@img/**}"
    },
    "api/trpc/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "{server/models/**,model/**,scripts/**,node_modules/onnxruntime-node/**,node_modules/sharp/**,node_modules/@img/**}"
    },
    "api/trpc/inference.classify.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/models/**,model/**,scripts/**,node_modules/onnxruntime-node/**,node_modules/sharp/**,node_modules/@img/**}"
    },
    "api/forecast.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/models/**,model/**,scripts/**,node_modules/onnxruntime-node/**,node_modules/sharp/**,node_modules/@img/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
